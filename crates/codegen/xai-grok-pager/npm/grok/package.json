    },
    "dependencies": {
        "@iarna/toml": "^3.0.0"
    },
    "optionalDependencies": {
        "@ezer/ezer-darwin-arm64": "0.1.220-alpha.4",
        "@ezer/ezer-darwin-x64": "0.1.220-alpha.4",
        "@ezer/ezer-linux-arm64": "0.1.220-alpha.4",
        "@ezer/ezer-linux-x64": "0.1.220-alpha.4",
        "@ezer/ezer-win32-arm64": "0.1.220-alpha.4",
        "@ezer/ezer-win32-x64": "0.1.220-alpha.4"
    }
}
